# Copy to .env (never commit .env). All values below are local-development defaults
# or empty placeholders; real credentials come from your shell or a secret store.

# --- Database (docker compose service "postgres") ---
DATABASE_URL=postgresql+asyncpg://chatbot:chatbot_dev_password@localhost:5432/chatbot
# Tests use their own database, never the dev one.
TEST_DATABASE_URL=postgresql+asyncpg://chatbot:chatbot_dev_password@localhost:5432/chatbot_test

# --- Auth (docker compose service "keycloak", realm infra/keycloak/realm-export.json) ---
AUTH_ISSUER=http://localhost:8080/realms/ai-chatbot-dev
AUTH_AUDIENCE=ai-chatbot-api
AUTH_JWKS_URL=http://localhost:8080/realms/ai-chatbot-dev/protocol/openid-connect/certs
AUTH_ALGORITHMS=RS256

# --- Assistants ---
ASSISTANT_CONFIGS_DIR=./configs

# --- Model providers (fill in locally; never commit real values) ---
GEMINI_API_KEY=
