{
  "realm": "ai-chatbot-dev",
  "displayName": "AI-Chatbot Development",
  "enabled": true,
  "sslRequired": "none",
  "accessTokenLifespan": 3600,
  "roles": {
    "realm": [
      {
        "name": "chatbot-admin",
        "description": "May call /admin/* routes (ingest, sync, usage)."
      }
    ]
  },
  "clients": [
    {
      "clientId": "ai-chatbot-api",
      "name": "AI-Chatbot",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:*",
        "http://127.0.0.1:*"
      ],
      "webOrigins": [
        "+"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "+"
      },
      "protocolMappers": [
        {
          "name": "ai-chatbot-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "ai-chatbot-api",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "dev_user",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Dana",
      "lastName": "Dev",
      "email": "dev_user@example.com",
      "credentials": [
        {
          "type": "password",
          "value": "dev_user_password",
          "temporary": false
        }
      ]
    },
    {
      "username": "dev_user2",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Sam",
      "lastName": "Dev",
      "email": "dev_user2@example.com",
      "credentials": [
        {
          "type": "password",
          "value": "dev_user2_password",
          "temporary": false
        }
      ]
    },
    {
      "username": "dev_admin",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Alex",
      "lastName": "Dev",
      "email": "dev_admin@example.com",
      "credentials": [
        {
          "type": "password",
          "value": "dev_admin_password",
          "temporary": false
        }
      ],
      "realmRoles": [
        "chatbot-admin"
      ]
    }
  ]
}
